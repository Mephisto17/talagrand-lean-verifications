@TalagrandConjectures.park_talagrand_theorem_2_1 : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p a : ℝ},
  0 < p →
    p < 1 →
      0 < a →
        a < 1 →
          ∀ (ν : TalagrandConjectures.Law X),
            ν.Spread (p * (1 - a) / ((1 - p) * a)) →
              ∀ {A : Set (TalagrandConjectures.Cube X)},
                TalagrandConjectures.Down A →
                  A.Nonempty →
                    Real.log (TalagrandConjectures.measure p A) ≤
                      ∑ J, ν.weight J * Real.log (TalagrandConjectures.theta a A J)
@TalagrandConjectures.conjecture_9_1_up : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p : ℝ},
  0 < p →
    p < 1 / 2 →
      ∀ (ν : TalagrandConjectures.Law X),
        ν.Spread (1 / 2 * p) →
          ∀ {A : Set (TalagrandConjectures.Cube X)},
            TalagrandConjectures.Up A →
              A ≠ Set.univ →
                -∑ J, ν.weight J * Real.log (1 - TalagrandConjectures.theta (1 / 2) A J) ≤
                  -Real.log (1 - TalagrandConjectures.measure p A)
@TalagrandConjectures.conjecture_9_1_multiplicative : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p : ℝ},
  0 < p →
    p < 1 / 2 →
      ∀ (ν : TalagrandConjectures.Law X),
        ν.Spread (1 / 2 * p) →
          ∀ {A : Set (TalagrandConjectures.Cube X)},
            TalagrandConjectures.Down A →
              A.Nonempty → TalagrandConjectures.measure p A ≤ ∏ J, TalagrandConjectures.theta (1 / 2) A J ^ ν.weight J
@TalagrandConjectures.conjecture_7_12 : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p : ℝ},
  0 < p →
    p < 1 →
      ∀ {A : Set (TalagrandConjectures.Cube X)},
        TalagrandConjectures.Up A →
          ∃ η,
            ∀ (J : TalagrandConjectures.Cube X),
              TalagrandConjectures.theta (1 / 2) A J ≤
                TalagrandConjectures.measure p A *
                  ∑ I, if I ≤ J then η.weight I / TalagrandConjectures.monoWeight (1 / 2 * p) I else 0
@TalagrandConjectures.conjecture_7_9 : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p a : ℝ},
  0 < p →
    p < 1 →
      0 < a →
        a ≤ TalagrandConjectures.goldenAlpha →
          ∀ (ν : TalagrandConjectures.Law X),
            ν.Spread (a * p) →
              ∀ {A : Set (TalagrandConjectures.Cube X)},
                TalagrandConjectures.Up A →
                  ∑ J, ν.weight J * TalagrandConjectures.theta a A J ≤ TalagrandConjectures.measure p A
@TalagrandConjectures.conjecture_7_3 : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p : ℝ},
  0 < p →
    p < 1 →
      ∀ {A : Set (TalagrandConjectures.Cube X)},
        TalagrandConjectures.Up A →
          TalagrandConjectures.WeaklySmall (1 / 2 * p)
            {J | TalagrandConjectures.measure p A < TalagrandConjectures.theta (1 / 2) A J}
@TalagrandConjectures.conjecture_7_2 : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p : ℝ},
  0 < p →
    p < 1 →
      ∀ (A : Set (TalagrandConjectures.Cube X)),
        1 - 1 / 3 ≤ TalagrandConjectures.measure p A →
          TalagrandConjectures.WeaklySmall p (TalagrandConjectures.badUnions 3 A)
@TalagrandConjectures.fang_wang_theorem_1_2 : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {p t q : ℝ},
  0 < p →
    p < 1 →
      0 < t →
        t < 1 →
          0 ≤ q →
            t * q * (1 - p) / (p * (1 - t)) ≤ 1 →
              ∀ (ν : TalagrandConjectures.Law X),
                ν.Spread q →
                  ∀ {A : Set (TalagrandConjectures.Cube X)},
                    TalagrandConjectures.Up A →
                      ∑ J, ν.weight J * TalagrandConjectures.theta t A J ≤ TalagrandConjectures.measure p A
@TalagrandConjectures.fang_wang_target_density : ∀ {X : Type} [inst : Fintype X] [inst_1 : DecidableEq X] {t q : ℝ},
  0 < t →
    t < 1 →
      0 < q →
        ∀ (ν : TalagrandConjectures.Law X),
          ν.Spread q →
